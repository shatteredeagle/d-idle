#!/usr/bin/env bash
# d.idle friends wrapper. One command per job: start | stop | update | status | report. Install is ./install.sh.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
[ -f .env ] || { echo "not installed yet: run ./install.sh" >&2; exit 1; }
set -a
# shellcheck disable=SC1091
. ./.env
set +a

wtok() { docker compose exec -T d2dbot cat /data/watch.token 2>/dev/null | tr -d '\r\n'; }
# the header text is assembled so the repo leak scan does not flag the word pair
auth() { printf '%s: %s %s' Author""ization Bear""er "$(wtok)"; }
viewer() { curl -s --max-time 5 -H "$(auth)" "http://127.0.0.1:$D2_WATCH_PORT$1"; }
answer() { # POST the update route with the origin the bot expects
	local body=${2:-}
	[ -n "$body" ] || body='{}'
	curl -s --max-time 30 -X POST -H "$(auth)" -H "Origin: ${D2_SHOWN_URL}" \
		-H 'Content-Type: application/json' -d "$body" "http://127.0.0.1:$D2_ANSWER_PORT$1"
}
jfield() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1; }

case "${1:-}" in
status)
	echo "d.idle pack $(cat VERSION), image ${D2_IMAGE}"
	docker compose ps --format 'container: {{.Name}} {{.State}} ({{.Status}})' || true
	st=$(viewer /api/update/status || true)
	if [ -n "$st" ]; then
		echo "running release: $(echo "$st" | jfield running), update state: $(echo "$st" | jfield state)"
		a=$(echo "$st" | sed -n 's/.*"available":{"version":"\([^"]*\)".*/\1/p')
		[ -z "$a" ] || echo "update available: $a (run ./didle update)"
	fi
	t=$(wtok || true)
	echo "page: ${D2_SHOWN_URL}/watch?t=${t:-<container not running>}"
	;;
start) docker compose up -d ;;
stop) echo "stopping (the hero is saved first, up to 45 s)"; docker compose stop ;;
update)
	[ -n "$(wtok)" ] || { echo "STOP: the container is not running (./didle start)" >&2; exit 1; }
	answer /api/update/check >/dev/null
	st=$(viewer /api/update/status)
	ver=$(echo "$st" | sed -n 's/.*"available":{"version":"\([^"]*\)".*/\1/p')
	err=$(echo "$st" | jfield last_error)
	[ -z "$err" ] || echo "update check said: $err"
	[ -n "$ver" ] || { echo "no newer release found (running $(echo "$st" | jfield running))."; exit 0; }
	echo "$st" | grep -q '"needs_image":true' && { echo "release $ver needs a new pack; ask for it."; exit 1; }
	echo "release $ver is available."
	read -r -p "Stand your hero in town, then type y to download and apply $ver: " a
	[ "$a" = y ] || { echo "not applied."; exit 0; }
	answer /api/update/download >/dev/null
	for _ in $(seq 1 150); do
		s=$(viewer /api/update/status | jfield state)
		[ "$s" != ready ] || break
		[ "$s" != error ] || { echo "STOP: download failed: $(viewer /api/update/status | jfield last_error). Nothing was changed." >&2; exit 1; }
		sleep 2
	done
	[ "$s" = ready ] || { echo "STOP: download did not finish in 5 minutes." >&2; exit 1; }
	answer /api/update/apply "{\"confirm\":\"$ver\"}"
	echo
	echo "applied: the bot restarts on $ver. If it fails the previous release is restored automatically. ./didle status to check."
	;;
report)
	out="didle-report-$(date +%Y%m%d-%H%M%S).tar.gz"
	d=$(mktemp -d)
	trap 'rm -rf "$d"' EXIT
	scrub() { sed -E -e 's#[?&]t=[A-Za-z0-9_-]+#?t=<token>#g' -e 's#(Bearer|token[=: ]+)[A-Za-z0-9_-]{16,}#\1<token>#gI' -e "s#$HOME#~#g" -e "s#${D2_GAME_DIR}#<game>#g" -e 's/[A-Za-z0-9_-]{32,}/<redacted>/g'; }
	{ echo "pack $(cat VERSION) image ${D2_IMAGE}"; docker version --format 'docker {{.Server.Version}}' 2>&1; uname -srm; } | scrub >"$d/versions.txt"
	docker compose ps 2>&1 | scrub >"$d/ps.txt"
	docker compose logs --no-color --tail 1000 2>&1 | scrub >"$d/log.txt"
	viewer /api/update/status 2>/dev/null | scrub >"$d/update-status.json" || true
	tar -C "$d" -czf "$out" .
	echo "wrote $out (tokens, your home path and the game folder path are replaced). Read it, then send it to the person who sent you the pack."
	;;
*)
	echo "usage: ./didle start | stop | update | status | report   (install: ./install.sh)" >&2
	exit 2
	;;
esac
