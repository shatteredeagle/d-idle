#!/bin/sh
# Pre-push: a push to refs/heads/main or refs/heads/master runs the leak scan. changecheck and the OpenSpec validator
# are no longer run here (OpenSpec removal stage 2). No tests here (the head box has 4 GB).
# Bypass: D2_SKIP_HOOKS=1 git push ... (loud note). See docs/process/hooks.md.
root=$(git rev-parse --show-toplevel) || exit 0
master=0
range=
while read -r _lref lsha rref rsha; do
	if [ "$rref" = refs/heads/master ] || [ "$rref" = refs/heads/main ]; then
		master=1
		range="$rsha..$lsha"
	fi
done
[ "$master" = 1 ] || exit 0
if [ "${D2_SKIP_HOOKS:-}" = 1 ]; then
	echo "!!! D2_SKIP_HOOKS=1: pre-push checks SKIPPED for a main/master push !!!" >&2
	exit 0
fi
cd "$root" || exit 1
# Leak scan of the pushed files: warn only until go-live, then change `warn` to `fail` (docs/process/public-split.md).
go run ./cmd/leakcheck -mode warn -staged -range "$range" >&2 || echo "pre-push: leakcheck could not run (warn only)" >&2
exit 0
