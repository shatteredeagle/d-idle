{
  "version": "didle.scenario/1",
  "scenarios": [
    {
      "id": "manage.equip-immediate",
      "title": "Hero fighting in a field with an upgrade in the pack: equipped from the Inventory sheet within 2 s of the tap, no town visit, the fight continues, the old item stays in the pack",
      "kind": "behaviour",
      "tier": "fast",
      "covers": [
        "manage.equip-instant"
      ],
      "touches": [
        "internal/invdesk/instant.go",
        "cmd/d2bot/invverbs.go"
      ],
      "pre": {
        "hero_profile": "banked",
        "level": 30,
        "gold": 0,
        "pack": [
          {
            "code": "cap",
            "quality": 4
          }
        ],
        "worn": [
          {
            "code": "cap",
            "slot": "head",
            "quality": 2
          }
        ]
      },
      "trigger": {
        "goals": "campaign",
        "knobs": {
          "ui.managementFast": 1
        },
        "api": [
          {
            "after_s": 3,
            "path": "/api/inventory/equip",
            "body": {
              "id": "{{pack.item[name=cap].id}}",
              "slot": "head"
            }
          }
        ]
      },
      "budget": {
        "virtual_min": 12
      },
      "matrix": {
        "classes": [
          "Paladin",
          "Sorceress"
        ],
        "seeds": [
          11,
          3
        ]
      },
      "needs": [
        "item.equip"
      ],
      "provenance": "SETUP (CHEATED, mechanics only): level, gold, the given and worn items and the vault record come from lab verbs and the runner's seeding. Not evidence about balance or parity.",
      "notes": "Both classes wear a helm (cap). RED first: with ui.managementFast 0 the same request waits for the bot's safe moment and the assert on the 2 s window fails.",
      "assert": [
        {
          "kind": "api_reply",
          "index": 0,
          "status": 200,
          "ok": true,
          "why": "the route took the order"
        },
        {
          "kind": "item_in_pack",
          "code": "cap",
          "where": "body",
          "why": "the upgrade is worn"
        },
        {
          "kind": "item_in_pack",
          "code": "cap",
          "where": "pack",
          "min": 1,
          "why": "the swapped-out helm stays in the pack, never dropped"
        },
        {
          "kind": "log_line",
          "pattern": "(drop|trash|sold|sell).*cap",
          "max": 0,
          "why": "nothing was dropped or sold"
        },
        {
          "kind": "log_line",
          "pattern": "totown|to town",
          "max": 0,
          "why": "no town visit (first two virtual minutes: a coarse bound, the bot's own sell trips come later)",
          "to_min": 2
        },
        {
          "kind": "no_writes"
        }
      ]
    },
    {
      "id": "manage.identify-immediate",
      "title": "An unidentified item in the pack and an identify scroll: identified from the sheet at once, in the field",
      "kind": "behaviour",
      "tier": "fast",
      "covers": [
        "manage.identify-instant"
      ],
      "touches": [
        "internal/invdesk/instant.go",
        "cmd/d2bot/invverbs.go"
      ],
      "pre": {
        "hero_profile": "banked",
        "level": 30,
        "gold": 0,
        "pack": [
          {
            "code": "cap",
            "quality": 4,
            "unid": true
          },
          {
            "code": "isc"
          }
        ]
      },
      "trigger": {
        "goals": "campaign",
        "knobs": {
          "ui.managementFast": 1
        },
        "api": [
          {
            "after_s": 3,
            "path": "/api/inventory/identify",
            "body": {
              "id": "{{pack.item[name=cap].id}}"
            }
          }
        ]
      },
      "budget": {
        "virtual_min": 12
      },
      "matrix": {
        "classes": [
          "Paladin",
          "Sorceress"
        ],
        "seeds": [
          11,
          3
        ]
      },
      "needs": [
        "item.identify"
      ],
      "provenance": "SETUP (CHEATED, mechanics only): level, gold, the given and worn items and the vault record come from lab verbs and the runner's seeding. Not evidence about balance or parity.",
      "notes": "U: the assertion that the item reads identified needs the observer; the log line is the weaker stand-in.",
      "assert": [
        {
          "kind": "api_reply",
          "index": 0,
          "status": 200,
          "ok": true,
          "why": "the route took the order"
        },
        {
          "kind": "log_line",
          "pattern": "player identify Cap",
          "min": 1,
          "why": "the lane identified it"
        },
        {
          "kind": "log_line",
          "pattern": "identify .* failed",
          "max": 0,
          "why": "the identify verb's change shows in the game"
        },
        {
          "kind": "log_line",
          "pattern": "totown|to town",
          "max": 0,
          "why": "no town visit (first two virtual minutes: a coarse bound, the bot's own sell trips come later)",
          "to_min": 2
        },
        {
          "kind": "no_writes"
        }
      ]
    },
    {
      "id": "manage.recall-now",
      "title": "Hero in the field, a Vault item to equip: Recall now walks home at the next safe moment, the order runs in town, the hero returns to the goal",
      "kind": "behaviour",
      "tier": "fast",
      "covers": [
        "manage.recall-now"
      ],
      "touches": [
        "internal/bot/recall.go",
        "internal/watch/recallapi.go",
        "internal/vaultkeep/equip.go"
      ],
      "pre": {
        "hero_profile": "banked",
        "level": 30,
        "gold": 500,
        "vault_records": {
          "items": [
            {
              "code": "cap",
              "quality": 4
            }
          ]
        }
      },
      "trigger": {
        "goals": "campaign",
        "knobs": {
          "ui.managementFast": 1,
          "loot.vault": 1,
          "loot.vaultKeep": 1,
          "loot.vaultEquip": 1
        },
        "api": [
          {
            "after_s": 10,
            "path": "/api/vault/equip",
            "body": {
              "ids": [
                "{{vault.0.id}}"
              ],
              "slot": "auto",
              "now": false
            }
          },
          {
            "after_s": 12,
            "path": "/api/recall",
            "body": {}
          }
        ]
      },
      "budget": {
        "virtual_min": 12
      },
      "matrix": {
        "classes": [
          "Paladin",
          "Sorceress"
        ],
        "seeds": [
          11,
          3
        ]
      },
      "needs": [
        "item.create",
        "item.full",
        "item.vault",
        "item.equip"
      ],
      "provenance": "SETUP (CHEATED, mechanics only): level, gold, the given and worn items and the vault record come from lab verbs and the runner's seeding. Not evidence about balance or parity.",
      "notes": "The hero starts in town (a field start cannot seed a Vault record: the seeding `item full` answers `#-1`, V 2026-11-22; belt potions break the seeding the same way, V) and the campaign walks it out in the first seconds. A chicken brings the hero home by itself on some seeds: then the trip line is absent and the run is not a test of the Recall walk. The trip line is the activity the runner sets; `recall trip` is only the do-label and is never logged (V: the trip ran and the first version of this assert read 0 lines).",
      "assert": [
        {
          "kind": "api_reply",
          "index": 0,
          "status": 200,
          "ok": true,
          "why": "the equip order was accepted"
        },
        {
          "kind": "api_reply",
          "index": 1,
          "status": 200,
          "why": "the recall route answered"
        },
        {
          "kind": "item_in_pack",
          "code": "cap",
          "where": "body",
          "why": "the helm is worn"
        },
        {
          "kind": "log_line",
          "pattern": "Going to town because you asked",
          "min": 1,
          "why": "the recall walk ran"
        },
        {
          "kind": "no_writes"
        }
      ]
    }
  ]
}
