     "riskTable": [{"match": {}, "class": "safe"}],
     "default": [{"when": {"freerows": "0|1"}, "answer": "go"}, {"when": {"kit": "THIN"}, "answer": "go"}, {"when": {}, "answer": "continue"}]},
    {"id": "t1.tp.lost", "tier": 1,
     "question": "No town portal scroll: buy one or walk?",
     "answers": [{"id": "buy", "label": "buy a scroll"}, {"id": "walk", "label": "walk back"}],
     "contextKeys": ["gold", "areaclass"],
     "riskTable": [{"match": {"areaclass": "boss"}, "class": "risky"}, {"match": {}, "class": "normal"}],
     "default": [{"when": {"gold": "lt100"}, "answer": "walk"}, {"when": {}, "answer": "buy"}]},
    {"id": "t1.stash.full", "tier": 1,
     "question": "The stash is full: sell, drop or pause?",
     "answers": [{"id": "sell", "label": "sell the surplus"}, {"id": "drop", "label": "drop the surplus"}, {"id": "pause", "label": "pause"}],
     "contextKeys": ["stash", "gold"],
     "riskTable": [{"match": {}, "class": "normal"}],
     "default": [{"when": {}, "answer": "sell"}]},
    {"id": "t1.repair", "tier": 1,
