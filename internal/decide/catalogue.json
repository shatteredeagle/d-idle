     "riskTable": [{"match": {}, "class": "risky"}],
     "default": [{"when": {"hc": "hardcore"}, "answer": "stop"}, {"when": {"deaths": "3+"}, "answer": "stop"}, {"when": {}, "answer": "continue"}]},
    {"id": "t2.slowrun", "tier": 2,
     "question": "The run is slower than expected: continue or switch?",
     "answers": [{"id": "continue", "label": "continue"}, {"id": "switch", "label": "switch run"}],
     "contextKeys": ["runkind", "timeratio"],
     "riskTable": [{"match": {}, "class": "normal"}],
     "default": [{"when": {}, "answer": "continue"}]},
    {"id": "t2.bossunsafe", "tier": 2,
     "question": "The boss is unsafe at the current gear: skip or go?",
