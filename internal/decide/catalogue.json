{
  "version": 1,
  "config": {
    "nByRisk": {"safe": 2, "normal": 3, "risky": 5},
    "fadeSec": 45,
    "maxSkips": 1
  },
  "fields": {
    "act":        {"kind": "enum", "values": ["1", "2", "3", "4", "5"]},
    "diff":       {"kind": "enum", "values": ["normal", "nightmare", "hell"]},
    "hc":         {"kind": "enum", "values": ["normal", "hardcore"]},
    "kit":        {"kind": "enum", "values": ["OK", "THIN", "NONE"]},
    "urgency":    {"kind": "enum", "values": ["calm", "wary", "urgent", "critical"]},
    "areaclass":  {"kind": "enum", "values": ["town", "field", "boss"]},
    "itemkind":   {"kind": "enum", "values": ["rune", "gem", "jewel", "rare", "charm", "unique"]},
    "itemclass":  {"kind": "enum", "values": ["magic", "higher"]},
    "scroll":     {"kind": "enum", "values": ["yes", "no"]},
    "belt":       {"kind": "enum", "values": ["full", "half", "low"]},
    "packdanger": {"kind": "enum", "values": ["1", "2", "3"]},
    "packtype":   {"kind": "enum", "values": ["ordinary", "fast", "ranged", "curse", "immune"]},
    "runkind":    {"kind": "enum", "values": ["farm", "quest", "level"]},
    "boss":       {"kind": "enum", "values": ["minor", "major"]},
    "gear":       {"kind": "enum", "values": ["low", "mid", "high"]},
    "merc":       {"kind": "enum", "values": ["alive", "dead", "none"]},
    "slot":       {"kind": "enum", "values": ["armor", "weapon", "jewelry"]},
    "potiontier": {"kind": "enum", "values": ["minor", "light", "normal", "greater"]},
    "life":       {"kind": "band", "edges": [25, 35, 55, 70], "labels": ["lt25", "25-35", "35-55", "55-70", "gt70"]},
    "gold":       {"kind": "band", "edges": [100, 500, 1500], "labels": ["lt100", "100-500", "500-1500", "gt1500"]},
    "levelgap":   {"kind": "band", "edges": [1, 4, 7], "labels": ["le0", "1-3", "4-6", "ge7"]},
    "freerows":   {"kind": "band", "edges": [1, 2], "labels": ["0", "1", "2+"]},
    "stash":      {"kind": "band", "edges": [50, 85, 100], "labels": ["lt50", "50-85", "85-99", "full"]},
    "deaths":     {"kind": "band", "edges": [2, 3], "labels": ["1", "2", "3+"]},
    "timeratio":  {"kind": "band", "edges": [0.7, 1.3], "labels": ["fast", "normal", "slow"]},
    "durability": {"kind": "band", "edges": [20, 30], "labels": ["lt20", "20-30", "gt30"]},
    "mana":       {"kind": "classband", "labels": ["low", "mid", "high"]}
  },
  "classes": {
    "sorceress": {"bands": {"mana": [30, 60]}},
    "paladin":   {"bands": {"mana": [15, 40]}}
  },
  "urgency": {
    "stage": 1,
    "doc": "Stage 2 hook (spec 2.3). Rows are data for the combat card; the store does not evaluate them. First match wins, top to bottom.",
    "edges": {"htlCritical": 2, "htlUrgent": 4, "htlWary": 6, "d5Urgent": 0.5, "hitWindowSec": 1.5, "healFactorWhileHit": 0.6},
    "rows": [
      {"band": "critical", "any": ["htl<2", "L<1.5*H", "D5>=L"]},
      {"band": "urgent", "any": ["htl<4", "D5>=0.5*L", "hit&&room>=1"]},
      {"band": "wary", "any": ["htl<6", "hit"]},
      {"band": "calm", "any": ["otherwise"]}
    ]
  },
  "points": [
    {"id": "t0.retreat.drink", "tier": 0, "urgency": true,
     "question": "Life is low: drink, run or portal?",
     "answers": [{"id": "drink", "label": "drink a potion"}, {"id": "run", "label": "run away"}, {"id": "portal", "label": "take a town portal"}],
     "contextKeys": ["life", "packdanger", "kit"],
     "riskTable": [{"match": {"hc": "hardcore"}, "class": "risky"}, {"match": {}, "class": "normal"}],
     "default": [{"when": {"kit": "NONE"}, "answer": "run"}, {"when": {}, "answer": "drink"}]},
    {"id": "t0.retreat.lethal", "tier": 0,
     "question": "A pack type that nearly killed us: avoid or fight?",
     "answers": [{"id": "avoid", "label": "avoid it", "noop": true}, {"id": "fight", "label": "fight it"}],
     "contextKeys": ["packtype", "kit"],
     "riskTable": [{"match": {}, "class": "risky"}],
     "default": [{"when": {}, "answer": "avoid"}]},
    {"id": "t0.area.toohard", "tier": 0,
     "question": "The area is far above the hero: go, skip or lower area?",
     "answers": [{"id": "go", "label": "go anyway"}, {"id": "skip", "label": "skip it"}, {"id": "lower", "label": "go to a lower area"}],
     "contextKeys": ["areaclass", "levelgap", "kit"],
     "riskTable": [{"match": {}, "class": "risky"}],
     "default": [{"when": {"kit": "NONE"}, "answer": "lower"}, {"when": {}, "answer": "skip"}]},
    {"id": "t0.retreat.repeat", "tier": 0,
     "question": "Two retreats in a row in this area: stay or leave?",
     "answers": [{"id": "stay", "label": "stay"}, {"id": "leave", "label": "leave the area"}],
     "contextKeys": ["areaclass", "kit"],
     "riskTable": [{"match": {"hc": "hardcore"}, "class": "risky"}, {"match": {}, "class": "normal"}],
     "default": [{"when": {}, "answer": "leave"}]},
    {"id": "t0.unique.fight", "tier": 0, "urgency": true,
     "question": "A champion or unique pack: fight or avoid?",
     "answers": [{"id": "fight", "label": "fight with the early drink line"}, {"id": "avoid", "label": "avoid it", "noop": true}],
     "contextKeys": ["packdanger", "life", "kit"],
     "riskTable": [{"match": {"hc": "hardcore"}, "class": "risky"}, {"match": {}, "class": "normal"}],
     "default": [
       {"when": {"kit": "OK", "life": "55-70|gt70"}, "answer": "fight"},
       {"when": {"kit": "OK", "urgency": "calm|wary"}, "answer": "fight"},
       {"when": {}, "answer": "avoid"}]},
    {"id": "t0.leave.safe", "tier": 0, "urgency": true,
     "question": "A fast or ranged pack: portal, run or stay?",
     "answers": [{"id": "portal", "label": "take a town portal"}, {"id": "run", "label": "run away"}, {"id": "stay", "label": "stay and fight"}],
     "contextKeys": ["packtype", "life", "kit"],
     "riskTable": [{"match": {"hc": "hardcore"}, "class": "risky"}, {"match": {}, "class": "normal"}],
     "default": [{"when": {"kit": "OK"}, "answer": "portal"}, {"when": {}, "answer": "run"}]},
    {"id": "t0.shrine", "tier": 0,
     "question": "A shrine: take it or avoid it?",
     "answers": [{"id": "take", "label": "take the shrine"}, {"id": "avoid", "label": "avoid it", "noop": true}],
     "contextKeys": ["life", "packdanger"],
     "riskTable": [{"match": {}, "class": "normal"}],
     "default": [{"when": {}, "answer": "avoid"}]},
    {"id": "t1.restock", "tier": 1,
     "question": "Restock belt potions now?",
     "answers": [{"id": "yes", "label": "restock"}, {"id": "no", "label": "not now"}],
     "contextKeys": ["gold", "belt"],
     "riskTable": [{"match": {}, "class": "safe"}],
     "default": [{"when": {"gold": "lt100"}, "answer": "no"}, {"when": {}, "answer": "yes"}]},
    {"id": "t1.return", "tier": 1,
     "question": "Return to the field after town?",
     "answers": [{"id": "yes", "label": "return"}, {"id": "no", "label": "stay in town"}],
     "contextKeys": ["areaclass", "kit"],
     "riskTable": [{"match": {"kit": "OK"}, "class": "safe"}, {"match": {}, "class": "normal"}],
     "default": [{"when": {"kit": "NONE"}, "answer": "no"}, {"when": {}, "answer": "yes"}]},
    {"id": "t1.keep.kind", "tier": 1, "irreversible": true,
