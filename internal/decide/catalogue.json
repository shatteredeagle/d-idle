     "contextKeys": ["gold", "belt", "potiontier"],
     "riskTable": [{"match": {}, "class": "safe"}],
     "default": [{"when": {}, "answer": "best"}]},
    {"id": "t1.gamble", "tier": 2, "irreversible": true,
     "question": "Spend gold gambling?",
