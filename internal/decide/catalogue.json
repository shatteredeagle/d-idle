     "contextKeys": ["gold", "slot"],
     "riskTable": [{"match": {}, "class": "normal"}],
     "default": [{"when": {}, "answer": "save"}]},
    {"id": "t2.repeat", "tier": 2,
     "question": "Repeat the same run?",
     "answers": [{"id": "again", "label": "run it again"}, {"id": "stop", "label": "stop"}],
     "contextKeys": ["runkind", "kit"],
     "riskTable": [{"match": {}, "class": "safe"}],
     "default": [{"when": {"kit": "OK"}, "answer": "again"}, {"when": {}, "answer": "stop"}]},
    {"id": "t2.failstreak", "tier": 2,
     "question": "Repeated deaths: stop or continue?",
     "answers": [{"id": "stop", "label": "stop", "noop": true}, {"id": "continue", "label": "continue"}],
