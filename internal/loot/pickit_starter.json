{
 "comment": "Starter pickit for the leveling Sorceress. Rules are tried in order, the first match wins. See rules.go for the format. Derived from docs/plan/data/pickit-starter.json.",
 "version": 1,
 "default": {"action": "drop", "tier": "C", "reason": "no rule matches"},
 "rules": [
  {"name": "quest items",      "match": {"quest": true},                                        "action": "keep",  "tier": "S", "prio": 100, "reason": "quest item"},
  {"name": "quest items by code", "match": {"codes": ["j34", "g34", "d33", "g33", "bbb", "qey", "qhr", "qbr", "qf1", "qf2", "mss", "hfh", "ice", "tr2", "xyz", "luv"]}, "action": "keep",  "tier": "S", "prio": 100, "reason": "act 3-5 quest item (docs/act3.md X6), in case items.txt does not flag it"},
  {"name": "unique charms",    "match": {"types": ["scha","mcha","lcha"], "qualities": ["unique"]}, "action": "stash", "tier": "S", "prio": 95, "reason": "unique charm (Annihilus, Torch, Gheed)"},
  {"name": "runes",            "match": {"types": ["rune"]},                                    "action": "stash", "tier": "S", "prio": 90, "reason": "rune"},
  {"name": "tomes",            "match": {"codes": ["tbk","ibk"], "needed": "tome"},             "action": "keep",  "tier": "S", "prio": 88, "reason": "tome we lack"},
  {"name": "top gems",         "match": {"codes": ["gzv","gly","glb","glg","glr","glw","gpv","gpy","gpb","gpg","gpr","gpw","skl","skz"]}, "action": "stash", "tier": "S", "prio": 80, "reason": "flawless or perfect gem"},
  {"name": "unique and set",   "match": {"qualities": ["unique","set"], "notTypes": ["scha","mcha","lcha"]}, "action": "stash", "tier": "A", "prio": 85, "reason": "unique or set item (identify, sell non-upgrades later)"},
  {"name": "rejuvenation",     "match": {"types": ["rpot"], "needed": "potion"},                "action": "keep",  "tier": "S", "prio": 65, "reason": "rejuvenation potion the belt or the spare slot needs"},
  {"name": "gold",             "match": {"types": ["gold"], "needed": "gold"},                  "action": "keep",  "tier": "S", "prio": 70, "reason": "gold"},
  {"name": "healing and mana", "match": {"types": ["hpot","mpot"], "needed": "potion"},         "action": "keep",  "tier": "S", "prio": 65, "reason": "potion the belt needs"},
  {"name": "town scrolls",     "match": {"codes": ["tsc","isc"], "needed": "scroll"},           "action": "keep",  "tier": "S", "prio": 60, "reason": "scroll we use"},
  {"name": "charms",           "match": {"types": ["scha","mcha","lcha"], "qualities": ["magic","rare"], "identified": true,
                                          "anyStats": [{"stat": 7, "min": 20, "shift": 8}, {"stat": 39, "min": 5}, {"stat": 41, "min": 5}, {"stat": 43, "min": 5}, {"stat": 45, "min": 5}, {"stat": 99, "min": 5}, {"stat": 127, "min": 1}, {"stat": 83, "min": 1}, {"stat": 188, "min": 1}]},
                                                                                                "action": "stash", "tier": "A", "prio": 70, "reason": "charm with life, resist, FHR or skills"},
  {"name": "charms to id",     "match": {"types": ["scha","mcha","lcha"], "qualities": ["magic","rare"], "identified": false},
                                                                                                "action": "keep",  "tier": "A", "prio": 70, "needId": true, "reason": "unidentified charm"},
  {"name": "spare supplies",  "match": {"types": ["hpot","mpot","rpot","spot","apot","wpot"]},      "action": "keep",  "tier": "C", "prio": 0,  "reason": "potion already in the pack"},
  {"name": "spare scrolls",   "match": {"codes": ["tsc","isc","tbk","ibk","key"]},           "action": "keep",  "tier": "C", "prio": 0,  "reason": "town supplies"},
  {"name": "spare gold",      "match": {"types": ["gold"]},                                  "action": "keep",  "tier": "C", "prio": 0,  "reason": "gold pile"},
  {"name": "jewels",           "match": {"types": ["jewl"]},                                    "action": "stash", "tier": "A", "prio": 60, "reason": "jewel"},
  {"name": "mid gems",         "match": {"codes": ["gsy","sku"]},                               "action": "stash", "tier": "A", "prio": 50, "reason": "topaz or skull"},
  {"name": "good jewelry",     "match": {"types": ["ring","amul"], "qualities": ["magic","rare"], "identified": true,
                                          "anyStats": [{"stat": 7, "min": 20, "shift": 8}, {"stat": 105, "min": 10}, {"stat": 127, "min": 1}, {"stat": 39, "min": 15}, {"stat": 41, "min": 15}, {"stat": 43, "min": 15}, {"stat": 45, "min": 15}]},
                                                                                                "action": "stash", "tier": "A", "prio": 55, "reason": "jewelry with life, FCR, skills or resist"},
  {"name": "jewelry to id",    "match": {"types": ["ring","amul","circ"], "qualities": ["magic","rare"], "identified": false},
                                                                                                "action": "keep",  "tier": "A", "prio": 55, "needId": true, "reason": "unidentified jewelry"},
  {"name": "runeword base 2", "match": {"qualities": ["normal","superior"], "types": ["tors","helm","shld","staf"], "needed": "runeword", "stats": [{"stat": 194, "min": 2, "max": 2}]},
                                                                                                "action": "stash", "tier": "A", "prio": 40, "reason": "2-socket base (Stealth, Lore, Rhyme, Leaf)"},
  {"name": "runeword base 3", "match": {"qualities": ["normal","superior"], "types": ["tors","shld"], "needed": "runeword", "stats": [{"stat": 194, "min": 3, "max": 3}]},
                                                                                                "action": "stash", "tier": "A", "prio": 40, "reason": "3-socket base (Ancient's Pledge, Enigma)"},
  {"name": "runeword base 4", "match": {"qualities": ["normal","superior"], "types": ["tors","helm","shld","weap"], "needed": "runeword", "stats": [{"stat": 194, "min": 4, "max": 4}]},
                                                                                                "action": "stash", "tier": "A", "prio": 40, "reason": "4-socket base (Spirit, Insight, Fortitude)"},
  {"name": "keys",             "match": {"codes": ["key"], "needed": "key"},                    "action": "keep",  "tier": "A", "prio": 20, "reason": "key"},
  {"name": "cube gems",      "match": {"types": ["gem"], "needed": "gem"},                  "action": "stash", "tier": "A", "prio": 45, "reason": "gem kept for cube upgrades (3 of a kind -> next grade)"},
  {"name": "low gems",         "match": {"types": ["gem"]},                                     "action": "sell",  "tier": "B", "prio": 10, "reason": "surplus low gem, sells"},
  {"name": "magic and rare",   "match": {"qualities": ["magic","rare","crafted"]},              "action": "sell",  "tier": "B", "prio": 5,  "reason": "magic or rare item, sells"},
  {"name": "junk",             "match": {"qualities": ["low","normal","superior"]},             "action": "drop",  "tier": "C", "prio": 0,  "reason": "plain or inferior item"}
 ]
}
