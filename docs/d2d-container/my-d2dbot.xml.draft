<?xml version="1.0"?>
<!-- DRAFT. Not installed. Would go to /boot/config/plugins/dockerMan/templates-user/my-d2dbot.xml and be applied with tpl-apply.sh
     (docs/d2d-container/design.md section 8). Every port and path below is a visible field in the NAS UI. -->
<Container version="2">
  <Name>d2dbot</Name>
  <Repository>d2dbot:dev</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <ReadMe/>
  <Overview>D.idle on d2d: idle bot for classic Diablo II LoD 1.14d on the open-source d2d engine (headless, offline, single player). Web UI = dashboard and setup; the token is in /data/token. Needs your own game MPQs in /game.</Overview>
  <Category>Other:</Category>
  <WebUI>http://[IP]:[PORT:8431]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--memory=3g --cpus=2 --stop-timeout 45 --cap-drop=ALL --security-opt=no-new-privileges:true --init</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>Built locally (image d2dbot:dev, loaded from the worker host), so "check for updates" shows "not available". Your own Diablo II MPQ files go in /game (read-only). Contains the GPL-3.0 d2d engine: see /usr/share/licenses/d2d in the image.</Requires>
  <Config Name="Web UI" Target="8431" Default="8431" Mode="tcp" Description="Dashboard and setup (token required). LAN only." Type="Port" Display="always" Required="false" Mask="false">8431</Config>
  <Config Name="Game viewer (optional)" Target="8432" Default="" Mode="tcp" Description="Separate view-only game stream. Leave empty to keep it off (the viewer is also proxied on the Web UI). LAN only." Type="Port" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/d2dbot/data" Mode="rw" Description="Token, slots, saves, logs, soak runs (owner uid 1000)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/d2dbot/data</Config>
  <Config Name="Game data (read-only)" Target="/game" Default="/mnt/user/appdata/d2dbot/game" Mode="ro" Description="Folder with your own d2data.mpq, d2exp.mpq, d2char.mpq, Patch_D2.mpq (and the other MPQs)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/d2dbot/game</Config>
  <Config Name="D2D_MODE" Target="D2D_MODE" Default="realtime" Mode="" Description="realtime (play) | lockstep (fast soak, game time only advances when the bot steps it) | timescale:N" Type="Variable" Display="always" Required="false" Mask="false">realtime</Config>
  <Config Name="D2FLEET_MAX_LOAD_FACTOR" Target="D2FLEET_MAX_LOAD_FACTOR" Default="-1" Mode="" Description="-1 = ignore host load (the container sees the host's load average)" Type="Variable" Display="always" Required="false" Mask="false">-1</Config>
  <Config Name="D2FLEET_SOAK" Target="D2FLEET_SOAK" Default="0" Mode="" Description="1 = judge every slot with the soak profile (only once the d2d soak driver exists)" Type="Variable" Display="always" Required="false" Mask="false">0</Config>
</Container>
